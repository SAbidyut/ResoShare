{
  "name": "resoshare-backend",
  "version": "1.0.0",
  "private": true,
  "description": "ResoShare shareholder portal API (Resonance Automation)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "migrate": "node dist/src/cli/migrate.js",
    "migrate:dev": "tsx src/cli/migrate.ts",
    "create-admin": "node dist/src/cli/create-admin.js",
    "gen-secrets": "node scripts/gen-secrets.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.0",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.7",
    "@fastify/rate-limit": "^11.2.2",
    "argon2": "^0.45.2",
    "fastify": "^5.12.8",
    "jose": "^6.2.15",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "secure-json-parse": "^4.1.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
