# Copy to .env and fill in. NEVER commit .env.
# Generate the secrets with:  npm run gen-secrets   (or: node scripts/gen-secrets.mjs)

# Public domain that points to this server (DNS A record). Caddy gets the HTTPS certificate automatically.
DOMAIN=share.rapti.net

# Secrets (the server refuses to start if any is missing, short or a placeholder)
JWT_SECRET=
HMAC_KEY=
DATA_ENC_KEY=
# Database owner (used only by the one-shot migrate job)
POSTGRES_PASSWORD=
# Restricted runtime role the API connects as (created/updated by the migrate job)
POSTGRES_APP_PASSWORD=

LOG_LEVEL=info

# Daily database backups (03:00 Asia/Dhaka) are kept this many days in the `backups` volume
BACKUP_KEEP_DAYS=14

# --- Only for running without docker compose ---
# NODE_ENV=production
# DATABASE_URL=postgres://resoshare_app:<app password>@127.0.0.1:5432/resoshare      (runtime role)
# Migrate job (run before starting the API):
#   DATABASE_URL=postgres://resoshare:<owner password>@127.0.0.1:5432/resoshare \
#   APP_DB_USER=resoshare_app APP_DB_PASSWORD=<app password> node dist/src/cli/migrate.js
# PUBLIC_BASE_URL=https://share.rapti.net
# UPLOAD_DIR=/var/lib/resoshare/uploads
# TRUST_PROXY=loopback
# PORT=3000
