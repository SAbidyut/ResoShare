# Copy to .env and fill in. NEVER commit .env.
# Generate the secrets with:  npm run gen-secrets   (or: node scripts/gen-secrets.mjs)

# Public domain that points to this server (DNS A record). Caddy gets the HTTPS certificate automatically.
DOMAIN=share.rapti.net

# Secrets (the server refuses to start if any is missing, short or a placeholder)
JWT_SECRET=
HMAC_KEY=
DATA_ENC_KEY=
POSTGRES_PASSWORD=

LOG_LEVEL=info

# --- Only for running the API without docker compose ---
# NODE_ENV=production
# DATABASE_URL=postgres://resoshare:<password>@127.0.0.1:5432/resoshare
# PUBLIC_BASE_URL=https://share.rapti.net
# UPLOAD_DIR=/var/lib/resoshare/uploads
# TRUST_PROXY=loopback
# PORT=3000
